---
interface Props { name: 'arrow' | 'code' | 'menu' | 'close' | 'sun' | 'moon' | 'download'; class?: string }
const { name, class: className } = Astro.props;
const paths = {
  download: 'M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5',
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  code: 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  menu: 'M4 6h16M4 12h16M4 18h16',
  close: 'm6 6 12 12M6 18 18 6',
  sun: 'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5',
  moon: 'M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z',
};
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
</svg>
