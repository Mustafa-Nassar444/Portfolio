---
interface Props { id: string; title: string; eyebrow?: string; description?: string; level?: 'h1' | 'h2' | 'h3' }
const { id, title, eyebrow, description, level: Heading = 'h2' } = Astro.props;
---
<div class="section-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {description && <p class="section-description">{description}</p>}
</div>
